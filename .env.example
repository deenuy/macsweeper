# MacSweeper environment variables
# Copy this file to .env and fill in values as needed.
# .env is listed in .gitignore and must never be committed.

# ── Notarization (optional, maintainers only) ─────────────────────────────────
# Required only when running `make notarize` to submit a release build to Apple.
# Use an App-Specific Password from appleid.apple.com, not your Apple ID password.
NOTARIZE=false
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
