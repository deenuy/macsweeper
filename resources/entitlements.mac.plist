<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for sandboxed apps to access user-selected files via Open panel -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- Access Downloads folder for junk scanner -->
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>

  <!-- Access ~/Library for cache/log scanning -->
  <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
  <array>
    <string>/Library/Caches/</string>
    <string>/Library/Logs/</string>
    <string>/Library/Mail/</string>
    <string>/Library/Application Support/</string>
  </array>

  <!-- Allow moving items to Trash (shell.trashItem) -->
  <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
  <array>
    <string>com.apple.dock.server</string>
    <string>com.apple.finder.ServiceProvider</string>
  </array>

  <!-- Required by Electron for JIT compilation in renderer -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Allow unsigned executable memory (required by V8/Node.js) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Allow DYLD environment variables (required by Electron helpers) -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- Disable library validation so Electron can load its own frameworks -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
